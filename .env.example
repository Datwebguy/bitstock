# Copy to .env and fill in. Never commit .env. Names only below; no real values here.

# Binance Web3 API (developer portal). Host the server in a region the API allows.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Optional override; default is https://web3.binance.com
BINANCE_WEB3_BASE_URL=

# BNB Smart Chain RPC. A keyed archive-capable RPC is needed for historical event logs.
BSC_RPC_URL=

# Dedicated hot wallets with small balances. Nothing else may use them.
VAULT_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Caps (enforced in code). Lower them as needed.
RELAYER_MAX_BNB=0.01
VAULT_MAX_USD=10

# Admin routes and kill switch
ADMIN_TOKEN=
KILL_SWITCH=0

# Guard
GUARD_RULES_VERSION=1
GUARD_WAIT_AFTER_OPEN_MINUTES=
GUARD_MAX_PRICE_IMPACT_PERCENT=
INDEPENDENT_REFERENCE_SOURCE=

# App
PORT=3000
PUBLIC_BASE_URL=
