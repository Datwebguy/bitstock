# Copy to .env and fill in. Never commit .env. Names only below; no real values here.

# Binance Web3 API (developer portal). Host the server in a region the API allows.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Optional override; default is https://web3.binance.com
BINANCE_WEB3_BASE_URL=

# BNB Smart Chain RPC. A keyed archive-capable RPC is needed for historical event logs.
BSC_RPC_URL=
# Optional: an archive-capable RPC for multiplier event history (defaults to BSC_RPC_URL, recent blocks only).
BSC_LOG_RPC_URL=
# RPC for transaction and receipt lookups (PublicNode refuses them as archive requests). Defaults to BSC_RPC_URL.
BSC_TX_RPC_URL=
# Minutes between multiplier sentry runs.
SENTRY_INTERVAL_MINUTES=10

# Caps (enforced in code). Lower them as needed. The gift's wallet caps are under "Gift" below.
# Largest single Mode A buy, in US dollars.
BUY_MAX_USD=5
# Decision checks allowed per client per minute.
RATE_LIMIT_PER_MINUTE=10

# Admin routes and kill switch
ADMIN_TOKEN=
KILL_SWITCH=0

# Guard
GUARD_RULES_VERSION=2
GUARD_WAIT_AFTER_OPEN_MINUTES=
GUARD_MAX_PRICE_IMPACT_PERCENT=
INDEPENDENT_REFERENCE_SOURCE=
# Pyth Pro API key (independent stock price). Sent only as a bearer token, server-side.
PYTH_API_KEY=

# App
PORT=3000
PUBLIC_BASE_URL=
# Browser origins allowed to call the API (strict CORS), comma-separated. The agent's /buy address redirects to the first origin listed here.
PUBLIC_WEB_ORIGIN=

# Gift (front door). Two dedicated hot wallets with small balances; never reuse them (AGENTS.md 0.4).
GIFT_VAULT_PRIVATE_KEY=
GIFT_RELAYER_PRIVATE_KEY=
# Shared with the web app (Vercel) so the agent accepts claims only through it.
GIFT_PROXY_SECRET=
# The stock the gift gives (contract address). Required when the gift wallets are set.
GIFT_TOKEN=
# Optional: the stock shown first (symbol or address). Empty means the first on Binance's live list.
FEATURED_TOKEN=
GIFT_CAMPAIGN_MAX_USD=1
# USDT the vault may hold beyond the campaign, for test sends. The vault refuses to fund or open above campaign + pool.
GIFT_TEST_POOL_USD=1
GIFT_RELAYER_MAX_BNB=0.01
GIFT_CLAIM_DAYS=7

# Web app: the GitHub repo (owner/name) the skill installs from and the About page links to. Empty hides both.
NEXT_PUBLIC_REPO=
# Reown (WalletConnect) project ID for the wallet modal. Public by design; set it in the host environment, never in code.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Translation of on-screen text (optional). Without a key the site stays in English.
OPENAI_API_KEY=
# Model used for translation; default gpt-4o-mini.
OPENAI_MODEL=
# /v1/translate is public, so it is bounded: sentences kept (oldest dropped first) and model calls per UTC day.
TRANSLATE_MAX_ROWS=20000
TRANSLATE_MAX_CALLS_PER_DAY=500
